{
  "name": "digital-watch-webpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Hebrew-first landing site for Digital Watch (המשמר הדיגיטלי). Static, no backend, no tracking.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/build-assets.mjs",
    "video:demo": "node scripts/build-demo-video.mjs",
    "video:prepare": "node scripts/prepare-report-video.mjs",
    "verify:public": "node scripts/verify-public-tree.mjs",
    "test": "playwright test",
    "test:links": "node scripts/check-external-links.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "5.3.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
