---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedVideo from '../components/FeaturedVideo.astro';
import Evidence from '../components/Evidence.astro';
import Why from '../components/Why.astro';
import How from '../components/How.astro';
import Gallery from '../components/Gallery.astro';
import People from '../components/People.astro';
import Support from '../components/Support.astro';
---

<Base
  home
  title="המשמר הדיגיטלי: ערנות אנושית לשיחות וידאו חיות"
  description="המשמר הדיגיטלי הוא מיזם התנדבותי, בפיתוח, שנועד להפחית חשיפת מידע רגיש של חיילים בשיחות וידאו חיות ברשת. הכירו את הבעיה, את המערכת ואת האנשים, ואת דרכי התמיכה."
>
  <Hero />
  <FeaturedVideo />
  <Evidence />
  <Why />
  <How />
  <Gallery />
  <People />
  <Support />
</Base>
