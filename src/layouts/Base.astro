---
import '@fontsource-variable/heebo';
import heeboHebrew from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import A11yPanel from '../components/A11yPanel.astro';
import { SITE } from '../data/site';
import { u } from '../data/url';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  noindex?: boolean;
}
const { title, description, home = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(u('img/og-card.jpg'), Astro.site).href;
const fullTitle = home ? title : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05143F" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- GitHub Pages cannot send security headers, so the policy is delivered as a meta tag: it keeps the "nothing third-party is loaded until the visitor presses Play" promise enforceable by the browser. The ONLY third-party origin allowed is the YouTube privacy-enhanced embed, as a frame. The site needs inline script/style (the pre-paint settings script, Astro's inline CSS). -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href={u('favicon.png')} />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="preload" as="font" type="font/woff2" href={heeboHebrew} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="סמל המשמר הדיגיטלי: מגן עם משקפת על רקע כוכב דו-משולשי" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // runs before first paint: marks JS as available and restores the visitor's own accessibility choices (kept only in this browser)
      (function () {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const s = JSON.parse(localStorage.getItem('dw-a11y') || '{}');
          if (s.text) d.setAttribute('data-text', s.text);
          if (s.contrast) d.setAttribute('data-contrast', 'high');
          if (s.motion) d.setAttribute('data-motion', 'reduce');
          if (s.links) d.setAttribute('data-links', '1');
          if (s.spacing) d.setAttribute('data-spacing', '1');
        } catch {
          /* storage unavailable: the page simply uses its defaults */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      דלגו לתוכן הראשי
    </a>
    <a class="skip skip--second" href="#a11y-open">
      דלגו להתאמות נגישות
    </a>
    <Header home={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer home={home} />
    <A11yPanel />
  </body>
</html>
