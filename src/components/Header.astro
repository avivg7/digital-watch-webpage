---
import { NAV, SITE } from '../data/site';
import { u } from '../data/url';
import Icon from './Icon.astro';
interface Props {
  home: boolean;
}
const { home } = Astro.props;
const prefix = home ? '' : u('');
---

<header class="site">
  <div class="wrap bar">
    <a class="brand" href={u('')} aria-label={`${SITE.name}: לעמוד הבית`}>
      <img src={u('img/digital-watch-emblem.webp')} width="40" height="40" alt="" />
      <span>{SITE.name}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" id="menu-toggle">
      <Icon name="menu" />
      <span class="sr-only">תפריט</span>
    </button>
    <nav class="nav" id="site-nav" aria-label="ניווט ראשי">
      {NAV.map((n) => (
        <a href={`${prefix}${n.href}`} data-nav={n.href.slice(1)}>
          {n.label}
        </a>
      ))}
      <a class="btn btn--primary" href={`${prefix}#support`}>
        תמכו במיזם
      </a>
    </nav>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>
<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.setAttribute('data-open', String(open));
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
  // marks the section being read in the main navigation (home page only)
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
  const sections = links.map((l) => document.getElementById(l.dataset.nav!)).filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            links.find((l) => l.dataset.nav === en.target.id)?.setAttribute('aria-current', 'true');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
