---
// Small inline icon set (one stroke weight, currentColor). Decorative by default: the label lives in the surrounding control.
interface Props {
  name: 'external' | 'menu' | 'close' | 'prev' | 'next' | 'expand' | 'access' | 'play';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<string, string> = {
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  prev: 'M9 5l7 7-7 7',
  next: 'M15 5l-7 7 7 7',
  expand: 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5',
  access: 'M12 6.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 8.5l7 1.5 7-1.5M12 10v4.5m0 0-3 6m3-6 3 6',
  play: 'M8 5.5v13l11-6.5-11-6.5Z',
};
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
