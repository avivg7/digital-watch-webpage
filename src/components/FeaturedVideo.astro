---
// Featured video: a large 16:9 poster that opens an accessible modal player. NOTHING video-related is requested until the visitor chooses to play.
// Two modes (src/data/video.config.json, docs/FEATURED_VIDEO.md):
//   demo   (default) an original first-party player demo. Labelled as such everywhere. The Channel 13 report is NOT hosted (rights pending, R-1).
//   report the report itself, only after the owner's written rights confirmation is recorded in the config (the build refuses otherwise).
import cfg from '../data/video.config.json';
import { LINKS } from '../data/site';
import { u } from '../data/url';
import Icon from './Icon.astro';

const mode = cfg.mode === 'report' ? 'report' : 'demo';
const isReport = mode === 'report';
if (isReport && !(cfg.rights.confirmedBy && cfg.rights.confirmedOn && cfg.rights.reference)) {
  throw new Error('video.config.json: mode "report" needs rights.confirmedBy, rights.confirmedOn and rights.reference (docs/FEATURED_VIDEO.md)');
}
const src = cfg[mode];
const copy = isReport
  ? {
      lede: 'צפו בתחקיר שממחיש מדוע נדרשת שכבת מודעות והגנה גם במרחב הדיגיטלי.',
      cta: 'לצפייה בתחקיר המלא',
      badge: 'תחקיר חדשות 13',
      dialogTitle: 'התחקיר המלא של חדשות 13',
      note: 'התחקיר הוא של חדשות 13 ומוצג כאן באישור בעלי הזכויות.',
    }
  : {
      lede: 'התחקיר של חדשות 13 ממחיש מדוע נדרשת שכבת מודעות והגנה גם במרחב הדיגיטלי. עד שפרסומו כאן יאושר, הנגן מציג סרטון הדגמה מקורי של האתר.',
      cta: 'הפעלת הדגמת הנגן',
      badge: 'הדגמת נגן · לא התחקיר',
      dialogTitle: 'הדגמת נגן: סרטון הדגמה מקורי של האתר',
      note: 'הסרטון בנגן הוא הדגמה מקורית של האתר ואינו התחקיר של חדשות 13. התחקיר עצמו שייך לחדשות 13 ואינו מתארח כאן.',
    };
const media = {
  h264: u(src.mp4),
  vp9: u(src.webm),
  poster: u(src.poster),
  captions: src.captions ? u(src.captions) : '',
  title: copy.dialogTitle,
};
---

<section class="sec sec--navy2 vid" id="video" aria-labelledby="video-title" data-video-mode={mode}>
  <div class="wrap">
    <div class="vid__head">
      <h2 id="video-title">
        <span>שיחה אחת.</span>
        <span>רגע אחד של חוסר תשומת לב.</span>
        <span class="vid__exposed">מידע שלא היה אמור להיחשף.</span>
      </h2>
      <p class="lede measure">{copy.lede}</p>
    </div>

    <div class="vid__stage">
      <button type="button" class="vid__poster" data-video-open aria-haspopup="dialog">
        <svg class="vid__art" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="vp-glow" cx="30%" cy="50%" r="70%">
              <stop offset="0" stop-color="#0474fc" stop-opacity=".5"></stop>
              <stop offset="1" stop-color="#0474fc" stop-opacity="0"></stop>
            </radialGradient>
            <linearGradient id="vp-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#142a66"></stop>
              <stop offset="1" stop-color="#05143f"></stop>
            </linearGradient>
            <linearGradient id="vp-cover" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#0474fc"></stop>
              <stop offset="1" stop-color="#01aefe"></stop>
            </linearGradient>
          </defs>
          <rect width="1280" height="720" fill="url(#vp-bg)"></rect>
          <rect width="1280" height="720" fill="url(#vp-glow)"></rect>
          <g stroke="#6fd3ff" stroke-opacity=".22" stroke-width="2">
            <circle cx="640" cy="360" r="150"></circle>
            <circle cx="640" cy="360" r="270"></circle>
            <circle cx="640" cy="360" r="400" stroke-opacity=".12"></circle>
          </g>
          <g transform="translate(120 140)">
            <rect width="400" height="330" rx="24" fill="#142a66" stroke="#b4c3e6" stroke-opacity=".4" stroke-width="2"></rect>
            <path d="M0 46h400" stroke="#b4c3e6" stroke-opacity=".25" stroke-width="2"></path>
            <circle cx="30" cy="23" r="6" fill="#b4c3e6" fill-opacity=".5"></circle>
            <circle cx="52" cy="23" r="6" fill="#b4c3e6" fill-opacity=".5"></circle>
            <circle cx="200" cy="140" r="52" fill="#3c6fd8"></circle>
            <path d="M120 330v-40a80 80 0 0 1 160 0v40" fill="#1f3a82"></path>
            <rect x="34" y="262" width="104" height="36" rx="18" fill="#fd3e4f"></rect>
            <rect x="150" y="262" width="84" height="36" rx="18" fill="#fd3e4f"></rect>
            <rect x="246" y="262" width="120" height="36" rx="18" fill="url(#vp-cover)"></rect>
          </g>
          <g transform="translate(790 190)">
            <rect width="360" height="30" rx="15" fill="#e9f0ff" fill-opacity=".92"></rect>
            <rect y="58" width="300" height="30" rx="15" fill="#e9f0ff" fill-opacity=".6"></rect>
            <rect y="116" width="330" height="30" rx="15" fill="#e9f0ff" fill-opacity=".92"></rect>
            <rect y="108" width="330" height="6" rx="3" fill="#fd3e4f" transform="translate(0 46)"></rect>
          </g>
        </svg>
        <span class="vid__shade" aria-hidden="true"></span>
        <span class="vid__badge" aria-hidden="true">
          {copy.badge}
        </span>
        <span class="vid__play" aria-hidden="true">
          <Icon name="play" />
        </span>
        <span class="vid__bar">
          <span class="vid__cta">{copy.cta}</span>
          {src.durationLabel && (
            <span class="vid__dur">
              <span class="sr-only">משך </span>
              <bdi>{src.durationLabel}</bdi>
            </span>
          )}
        </span>
      </button>
    </div>

    <div class="vid__meta">
      <p class="vid__note">{copy.note}</p>
      <p class="vid__article">
        <span class="vid__article-k">הכתבה באתר חדשות 13 (קישור לאתר, לא לסרטון):</span>
        <a href={LINKS.channel13} target="_blank" rel="noopener noreferrer">
          לכתבה באתר חדשות 13 <Icon name="external" class="ext-ic" />
          <span class="sr-only"> (נפתח בלשונית חדשה)</span>
        </a>
      </p>
    </div>

    <noscript>
      <p class="vid__nojs">
        הנגן דורש JavaScript.
        <a href={media.h264}>{isReport ? 'פתיחת הסרטון בקובץ נפרד' : 'פתיחת סרטון ההדגמה בקובץ נפרד'}</a>
      </p>
    </noscript>
  </div>

  <dialog class="vdlg" id="video-dialog" aria-labelledby="vdlg-title" data-media={JSON.stringify(media)}>
    <div class="vdlg__in">
      <div class="vdlg__top">
        <p class="vdlg__title" id="vdlg-title">
          {copy.dialogTitle}
        </p>
        <div class="vdlg__tools">
          <button type="button" class="btn btn--ghost" data-video-fs hidden>
            <Icon name="expand" />
            <span>מסך מלא</span>
          </button>
          <button type="button" class="btn btn--ghost" data-video-close>
            <Icon name="close" />
            <span>סגירה</span>
          </button>
        </div>
      </div>
      <div class="vdlg__frame" data-video-frame>
        <div class="vdlg__err" data-video-err role="alert" hidden>
          <p class="vdlg__err-t">הסרטון לא נטען.</p>
          <p>אפשר לנסות שוב, או לסגור את החלון. החיבור לרשת או הדפדפן עלולים למנוע את ההפעלה.</p>
          <p class="vdlg__err-a">
            <button type="button" class="btn btn--light" data-video-retry>
              ניסיון נוסף
            </button>
            <a class="btn btn--ghost" href={LINKS.channel13} target="_blank" rel="noopener noreferrer">
              הכתבה באתר חדשות 13
              <Icon name="external" class="ext-ic" />
              <span class="sr-only"> (נפתח בלשונית חדשה, קישור לכתבה ולא לסרטון)</span>
            </a>
          </p>
        </div>
      </div>
      <p class="vdlg__note">{copy.note}</p>
    </div>
  </dialog>
</section>
<script>
  type Media = { h264: string; vp9: string; poster: string; captions: string; title: string };
  const dlg = document.getElementById('video-dialog') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-video-open]');
  if (dlg && opener) {
    const media: Media = JSON.parse(dlg.dataset.media || '{}');
    const frame = dlg.querySelector<HTMLElement>('[data-video-frame]')!;
    const err = dlg.querySelector<HTMLElement>('[data-video-err]')!;
    const fsBtn = dlg.querySelector<HTMLButtonElement>('[data-video-fs]')!;
    let video: HTMLVideoElement | null = null;

    const fail = () => {
      err.hidden = false;
      video?.setAttribute('hidden', '');
      dlg.querySelector<HTMLElement>('[data-video-retry]')?.focus();
    };
    // the video element, its sources and its caption track are created only now, after the visitor chose to play
    const mount = () => {
      err.hidden = true;
      video?.remove();
      const v = document.createElement('video');
      v.controls = true;
      v.playsInline = true;
      v.preload = 'metadata';
      v.poster = media.poster;
      v.setAttribute('aria-label', media.title);
      v.setAttribute('controlslist', 'nodownload');
      const add = (url: string, type: string) => {
        const s = document.createElement('source');
        s.src = url;
        s.type = type;
        v.append(s);
      };
      add(media.h264, 'video/mp4; codecs="avc1.640028"');
      add(media.vp9, 'video/webm; codecs="vp9"');
      if (media.captions) {
        const t = document.createElement('track');
        t.kind = 'captions';
        t.srclang = 'he';
        t.label = 'עברית';
        t.src = media.captions;
        v.append(t);
      }
      // an error on the video itself, or on the LAST source (every source failed), means nothing can be played
      v.addEventListener(
        'error',
        (e) => {
          const t = e.target as HTMLElement;
          if (t === v || t === v.querySelector('source:last-of-type')) fail();
        },
        true,
      );
      frame.prepend(v);
      video = v;
      // playback starts only because the visitor pressed the poster; the browser decides whether sound is allowed
      v.play().catch(() => undefined);
      v.focus({ preventScroll: true });
    };
    const unmount = () => {
      if (!video) return;
      video.pause();
      video.querySelectorAll('source, track').forEach((n) => n.remove());
      video.removeAttribute('src');
      video.load(); // aborts any download in progress
      video.remove();
      video = null;
    };

    opener.addEventListener('click', () => {
      dlg.showModal();
      mount();
    });
    dlg.querySelector('[data-video-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-video-retry]')!.addEventListener('click', mount);
    // a click on the dim area (the dialog element itself, outside the panel) closes it, as in the screenshot viewer
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => {
      unmount();
      err.hidden = true;
      opener.focus();
    });
    // Escape is handled by the dialog itself (it pauses through close); fullscreen has its own Escape and returns here
    const canFs = !!(
      document.fullscreenEnabled || (document.createElement('video') as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen
    );
    if (canFs) fsBtn.hidden = false;
    fsBtn.addEventListener('click', () => {
      if (!video) return;
      const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (v.requestFullscreen) v.requestFullscreen().catch(() => v.webkitEnterFullscreen?.());
      else v.webkitEnterFullscreen?.();
    });
  }
</script>
