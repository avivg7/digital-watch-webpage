---
// Featured report video: a large 16:9 poster that opens an accessible modal player. The poster is original local artwork, so NOTHING from YouTube (no script, frame,
// image or request) is loaded until the visitor presses Play. On Play, one iframe of the YouTube privacy-enhanced embed is created inside the dialog; on close it is removed.
// The video is the owner's upload of a Channel 13 report (src/data/video.config.json). Embedding it is not evidence of republication rights: see docs/FEATURED_VIDEO.md.
import cfg from '../data/video.config.json';
import { LINKS } from '../data/site';
import { u } from '../data/url';
import Icon from './Icon.astro';

const srcset = (fmt: 'avif' | 'webp') => [640, 1200, 1920].map((w) => `${u(`img/video-front-${w}.${fmt}`)} ${w}w`).join(', ');
const sizes = '(min-width: 1260px) 1180px, 94vw';
const media = { id: cfg.id, host: cfg.embedHost, title: cfg.title, watch: cfg.watchUrl };
if (cfg.watchUrl !== `https://www.youtube.com/watch?v=${cfg.id}` || LINKS.youtube !== cfg.watchUrl) {
  throw new Error('video.config.json and LINKS.youtube must point at the same YouTube video ID');
}
---

<section class="sec sec--navy2 vid" id="video" aria-labelledby="video-title">
  <div class="wrap">
    <div class="vid__head">
      <h2 id="video-title">
        <span>שיחה אחת.</span>
        <span>רגע אחד של חוסר תשומת לב.</span>
        <span class="vid__exposed">מידע שלא היה אמור להיחשף.</span>
      </h2>
      <p class="lede measure">צפו בתחקיר שממחיש מדוע נדרשת שכבת מודעות והגנה גם במרחב הדיגיטלי.</p>
    </div>

    <div class="vid__stage">
      <button type="button" class="vid__poster" data-video-open aria-haspopup="dialog">
        <picture class="vid__pic" aria-hidden="true">
          <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
          <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
          <img src={u('img/video-front-1200.webp')} width="1920" height="1080" alt="" loading="lazy" decoding="async" />
        </picture>
        <span class="vid__shade" aria-hidden="true"></span>
        <span class="vid__play" aria-hidden="true">
          <Icon name="play" />
        </span>
        <span class="vid__label">לצפייה בתחקיר המלא</span>
        <span class="sr-only">
          . סרטון מיוטיוב, נפתח בחלון נגן. תמונת התצוגה לקוחה מהתחקיר: שיחת וידאו של חייל בפנים מטושטשות לצד שתי נשים, ובתחתית כיתוב של חדשות 13.
        </span>
      </button>
    </div>

    <div class="vid__meta">
      <p class="vid__note">התחקיר של חדשות 13 מוצג כאן בהטמעה מיוטיוב. הוא נטען רק לאחר לחיצה על הפעלה, והזכויות בו שמורות לבעליהן.</p>
      <p class="vid__article">
        <a href={LINKS.youtube} target="_blank" rel="noopener noreferrer">
          לצפייה ביוטיוב <Icon name="external" class="ext-ic" />
          <span class="sr-only"> (נפתח בלשונית חדשה, אותו סרטון)</span>
        </a>
      </p>
    </div>

    <noscript>
      <p class="vid__nojs">
        הנגן דורש JavaScript.
        <a href={LINKS.youtube}>לצפייה בתחקיר ביוטיוב</a>
      </p>
    </noscript>
  </div>

  <dialog class="vdlg" id="video-dialog" aria-labelledby="vdlg-title" data-media={JSON.stringify(media)}>
    <div class="vdlg__in">
      <div class="vdlg__top">
        <p class="vdlg__title" id="vdlg-title">
          התחקיר המלא: כתבה בערוץ 13
        </p>
        <div class="vdlg__tools">
          <button type="button" class="btn btn--ghost" data-video-close>
            <Icon name="close" />
            <span>סגירה</span>
          </button>
        </div>
      </div>
      <div class="vdlg__frame" data-video-frame>
        <div class="vdlg__err" data-video-err role="alert" hidden>
          <p class="vdlg__err-t">הסרטון לא נטען כאן.</p>
          <p>החיבור לרשת, חסימה בדפדפן או הגבלה של יוטיוב עלולים למנוע את ההפעלה. אפשר לנסות שוב או לצפות בו ישירות ביוטיוב.</p>
          <p class="vdlg__err-a">
            <a class="btn btn--light" href={LINKS.youtube} target="_blank" rel="noopener noreferrer">
              לצפייה ביוטיוב
              <Icon name="external" class="ext-ic" />
              <span class="sr-only"> (נפתח בלשונית חדשה, אותו סרטון)</span>
            </a>
            <button type="button" class="btn btn--ghost" data-video-retry>
              ניסיון נוסף
            </button>
          </p>
        </div>
      </div>
      <div class="vdlg__foot">
        <p class="vdlg__note">
          הסרטון נטען מיוטיוב (Google) רק עכשיו, בלחיצתכם. אם הוא לא מתנגן,
          <a href={LINKS.youtube} target="_blank" rel="noopener noreferrer">
            לצפייה ביוטיוב.<span class="sr-only"> (נפתח בלשונית חדשה)</span>
          </a>
          <span class="sr-only">
            {' '}
            לסגירה: Escape, או הכפתור ״סגירת הנגן״ שבהמשך. כשהמקלדת בתוך הנגן של יוטיוב, Escape שייך לו, ו-Tab מוביל אל כפתור הסגירה.
          </span>
        </p>
        <button type="button" class="btn btn--ghost" data-video-close>
          <Icon name="close" />
          <span>סגירת הנגן</span>
        </button>
      </div>
    </div>
  </dialog>
</section>
<script>
  type Media = { id: string; host: string; title: string; watch: string };
  const dlg = document.getElementById('video-dialog') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-video-open]');
  if (dlg && opener) {
    const media: Media = JSON.parse(dlg.dataset.media || '{}');
    const frame = dlg.querySelector<HTMLElement>('[data-video-frame]')!;
    const err = dlg.querySelector<HTMLElement>('[data-video-err]')!;
    let player: HTMLIFrameElement | null = null;
    let timer = 0;
    // a cross-origin player cannot report why it failed, so three things count as "did not load": the browser refused the frame (CSP), the visitor is offline,
    // or the frame never finished loading. YouTube's own in-player messages (restricted, removed, referrer) stay inside the frame; the link below the player is always visible.
    const fail = () => {
      window.clearTimeout(timer);
      err.hidden = false;
      player?.setAttribute('hidden', '');
      err.querySelector<HTMLElement>('a')?.focus();
    };
    const onViolation = (e: SecurityPolicyViolationEvent) => {
      if (e.violatedDirective.startsWith('frame-src') || e.violatedDirective.startsWith('child-src')) fail();
    };
    const mount = () => {
      err.hidden = true;
      unmount();
      if (!navigator.onLine) return fail();
      const f = document.createElement('iframe');
      const q = new URLSearchParams({ autoplay: '1', rel: '0', playsinline: '1', hl: 'he', origin: location.origin });
      f.title = media.title;
      // fullscreen comes from the allowfullscreen attribute (naming it in `allow` as well makes Chromium warn that `allow` takes precedence)
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.addEventListener('load', () => window.clearTimeout(timer));
      document.addEventListener('securitypolicyviolation', onViolation);
      frame.prepend(f);
      player = f;
      timer = window.setTimeout(fail, Number(dlg.dataset.timeout) || 15000);
      // the source is set last, after the element is in the page and every listener is attached; the id comes from the page's own data, never from the URL
      f.src = `${media.host}/embed/${encodeURIComponent(media.id)}?${q.toString()}`;
    };
    // removing the iframe from the page destroys the player: playback and audio stop at once, and nothing stays connected to YouTube
    function unmount() {
      window.clearTimeout(timer);
      document.removeEventListener('securitypolicyviolation', onViolation);
      if (!player) return;
      player.src = 'about:blank';
      player.remove();
      player = null;
    }

    opener.addEventListener('click', () => {
      dlg.showModal();
      mount();
    });
    dlg.querySelectorAll('[data-video-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.querySelector('[data-video-retry]')!.addEventListener('click', mount);
    // a click on the dim area (the dialog element itself, outside the panel) closes it, as in the screenshot viewer
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => {
      unmount();
      err.hidden = true;
      opener.focus();
    });
  }
</script>
