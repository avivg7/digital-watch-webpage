---
import { u } from '../data/url';
// The hero image: a 24-hour dial split into the six 4-hour shifts the product is built around, a slow sweep hand, and one coral signal (exposure) on the outer ring.
// Pure SVG/CSS: no canvas, no script, no external file apart from the real emblem. In its final state without any animation (reduced motion, no CSS animation support).
const C = 300;
const pt = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)] as const;
};
const arcPath = (a0: number, a1: number, r: number) => {
  const [x0, y0] = pt(a0, r);
  const [x1, y1] = pt(a1, r);
  return `M${x0.toFixed(2)} ${y0.toFixed(2)} A${r} ${r} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
};
const arcs = Array.from({ length: 6 }, (_, i) => ({ d: arcPath(i * 60 + 3.5, (i + 1) * 60 - 3.5, 205), live: i === 4 }));
const ticks = Array.from({ length: 24 }, (_, i) => {
  const major = i % 4 === 0;
  const [x0, y0] = pt(i * 15, 262);
  const [x1, y1] = pt(i * 15, major ? 238 : 250);
  return { x0, y0, x1, y1, major };
});
const labels = [0, 4, 8, 12, 16, 20].map((h) => {
  const [x, y] = pt(h * 15, 318);
  return { h: String(h).padStart(2, '0'), x, y };
});
const wedges = Array.from({ length: 14 }, (_, i) => {
  const [x0, y0] = pt(-(i + 1) * 4, 252);
  const [x1, y1] = pt(-i * 4, 252);
  return { d: `M${C} ${C} L${x0.toFixed(2)} ${y0.toFixed(2)} A252 252 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`, o: (0.2 * (14 - i)) / 14 };
});
const [sx, sy] = pt(44, 285);
---

<div class="dial" role="img" aria-label="איור: שעון של 24 שעות המחולק לשש משמרות של ארבע שעות, וסמל המשמר הדיגיטלי במרכזו">
  <svg viewBox="-50 -50 700 700" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="arcLive" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0474FC" />
        <stop offset="1" stop-color="#01AEFE" />
      </linearGradient>
      <linearGradient id="handGrad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#01AEFE" stop-opacity="0" />
        <stop offset="1" stop-color="#6FD3FF" />
      </linearGradient>
    </defs>
    <circle class="ring" cx={C} cy={C} r="285" />
    <circle class="ring" cx={C} cy={C} r="170" />
    {ticks.map((t) => (
      <line class={t.major ? 'tick tick--major' : 'tick'} x1={t.x0} y1={t.y0} x2={t.x1} y2={t.y1} />
    ))}
    {arcs.map((a) => (
      <path class={a.live ? 'arc arc--live' : 'arc'} d={a.d} pathLength="1" />
    ))}
    <g class="dial__labels" text-anchor="middle" dominant-baseline="middle">
      {labels.map((l) => (
        <text x={l.x} y={l.y}>
          {l.h}
        </text>
      ))}
    </g>
    <g class="hand-group">
      {wedges.map((w) => (
        <path d={w.d} fill="#01AEFE" fill-opacity={w.o} />
      ))}
      <line class="hand" x1={C} y1={C} x2={C} y2="48" />
    </g>
    <circle class="signal-halo" cx={sx} cy={sy} r="14" />
    <circle class="signal" cx={sx} cy={sy} r="9" />
  </svg>
  <div class="dial__emblem">
    <img src={u('img/digital-watch-emblem.webp')} width="512" height="512" alt="" decoding="async" fetchpriority="high" />
  </div>
</div>
